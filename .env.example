# ==============================================================================
# Omnibridge Environment Configuration (Pure Model-Agnostic)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Universal LLM Configuration
# ------------------------------------------------------------------------------
# Omnibridge connects to any LLM endpoint (OpenAI, Gemini, DeepSeek, Groq, Ollama)
# using standard OpenAI-compatible wire format:

# Example A: Using Google Gemini (Get free key from https://aistudio.google.com/)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# Example B: Using OpenAI (GPT-4o)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Example C: Using DeepSeek (V3 / R1)
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat

# Example D: Using Local Ollama (Free, offline, private)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 3. Blockchain Signer & Execution
# ------------------------------------------------------------------------------
# Optional EVM private key (hex string, with or without 0x prefix).
# If omitted or left blank, Omnibridge runs in Simulation & Dry-Run mode.
PRIVATE_KEY=your_evm_private_key_here

# ------------------------------------------------------------------------------
# 4. Custom RPC URL Overrides (Optional - defaults to public endpoints from config/chains.json)
# ------------------------------------------------------------------------------
# POLYGON_RPC_URL=https://polygon-rpc.com
# BASE_RPC_URL=https://mainnet.base.org
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# OPTIMISM_RPC_URL=https://mainnet.optimism.io
# ETHEREUM_RPC_URL=https://eth.llamarpc.com
